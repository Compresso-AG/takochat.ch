# Tako – Umgebungsvariablen
# Diese Datei als Vorlage kopieren und ausfüllen:
#   cp .env.example .env
#
# WICHTIG: Die .env-Datei liegt im Repo-Root, also EINE Ebene über dem
# public/-Docroot. Dadurch ist sie nie über den Webserver erreichbar.
# Sie ist via .gitignore vom Versionsverwaltung ausgeschlossen.

# OpenAI API Key für den Chatbot (api/chat.php)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
